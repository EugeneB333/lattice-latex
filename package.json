{
  "name": "lattice-latex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "backend:build": "PATH=\"$HOME/.cargo/bin:$PATH\" CARGO_TARGET_DIR=/dev/shm/lattice-backend-target cargo build --manifest-path backend/Cargo.toml",
    "backend:test": "PATH=\"$HOME/.cargo/bin:$PATH\" CARGO_TARGET_DIR=/dev/shm/lattice-backend-target cargo test --manifest-path backend/Cargo.toml",
    "desktop": "npm run backend:build && node electron/launch.cjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/katex": "^0.16.8",
    "harper.js": "^2.10.0",
    "katex": "^0.18.7",
    "lucide-react": "^0.542.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.10.3",
    "jsdom": "^26.1.0",
    "typescript": "~7.0.2",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "dompurify": "^3.4.13"
  }
}
